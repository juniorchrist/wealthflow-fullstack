# ============================================================
#  .gitignore — WealthFlow (Fullstack Monorepo)
# ============================================================

# ── Dépendances ───────────────────────────────────────────────
node_modules/
backend/node_modules/

# ── Variables d'environnement SECRETS ─────────────────────────
# ⚠️ NE JAMAIS COMMITTER les fichiers .env réels
.env
backend/.env

# On commit uniquement les exemples
!.env.example
!backend/.env.example

# ── Build outputs ─────────────────────────────────────────────
dist/
backend/dist/
build/

# ── Prisma runtime ────────────────────────────────────────────
backend/node_modules/.prisma/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / IDE ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Cache ─────────────────────────────────────────────────────
.cache/
.parcel-cache/
.vite/
