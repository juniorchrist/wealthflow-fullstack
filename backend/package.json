{
  "name": "wealthflow-backend",
  "version": "2.0.0",
  "private": true,
  "description": "WealthFlow REST API - Node.js + Express + TypeScript + Prisma + PostgreSQL",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:test": "node test-db.js",
    "test:api": "tsx tests/verify-api.ts",
    "test:audit": "tsx tests/audit-full.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "prisma": "^6.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
