# ==============================================================================
# WEALTHFLOW V2 - BACKEND (RENDER / NODE.JS / SUPABASE)
# ==============================================================================

# Database : URL de connexion PostgreSQL Supabase (Pooler en production ou Direct connection)
# Exemple: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.xhwmunxtzgtbvwttsdry:NbRUQoBq9oZi1iBr@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Server
PORT=5000
NODE_ENV=production

# JWT - Clés secrètes d'authentification (32 caractères minimum)
JWT_SECRET="wealthflow-super-secret-jwt-key-2026-production-secure"
JWT_REFRESH_SECRET="wealthflow-super-secret-refresh-key-2026-production-secure"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend - URLs autorisées pour CORS (séparées par des virgules)
# Inclure : Netlify, InfinityFree, et localhost pour développement
# Exemples: https://votre-app.netlify.app,https://votre-domaine.infinityfreeapp.com
FRONTEND_URL="https://fluffy-panda-d9b796.netlify.app,http://localhost:5173,http://localhost:3000"

# Sécurité & Performance
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
