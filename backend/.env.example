# ============================================================
#  .env.example — Variables d'environnement Backend (Render)
#  ⚠️  Copier ce fichier en .env et remplir les valeurs réelles
#      Ne jamais committer le fichier .env !
# ============================================================

# ── Serveur ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # En production sur Render: production

# ── Base de données Supabase ──────────────────────────────────
# 1. Aller sur https://supabase.com/dashboard
# 2. Projet → Settings → Database → Connection string → URI
# 3. Coller ici (avec le mot de passe réel à la place de [YOUR-PASSWORD])
#
# Pour la connexion directe (migrations/push) utilisez le port 5432 :
# DATABASE_URL="postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres"
#
# Pour la production via Transaction Pooler (recommandé sur Render) :
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# ── JWT ────────────────────────────────────────────────────────
# Générer un secret fort: openssl rand -base64 64
JWT_SECRET="remplacer_par_une_chaine_aleatoire_tres_longue_et_secrete"
JWT_EXPIRES_IN="7d"

# ── CORS ────────────────────────────────────────────────────────
# En développement:
# CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
# En production (URL Netlify de votre app):
CORS_ORIGIN="https://votre-app.netlify.app"
